# Copy this file to .env.doris and replace every empty required value.
# .env.doris is ignored by Git. Never commit credentials or workload epochs.
# For a company-managed Doris cluster, request four distinct workload users;
# do not copy one shared account into every DORIS_*_USER variable.

COMPOSE_PROJECT_NAME=langfuse-doris
LANGFUSE_WEB_IMAGE=langfuse-doris-web:local
LANGFUSE_WORKER_IMAGE=langfuse-doris-worker:local

# Langfuse application and bundled single-host dependencies.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
SALT=
ENCRYPTION_KEY=
DATABASE_URL=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
REDIS_AUTH=
MINIO_ROOT_USER=langfuse
MINIO_ROOT_PASSWORD=
TELEMETRY_ENABLED=false
LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=false

# Optional self-hosted Enterprise license. Keep empty for OSS. Store the real
# value in a secret manager rather than committing it.
LANGFUSE_EE_LICENSE_KEY=

# Optional Enterprise ingestion masking. The callback is invoked by Worker
# before canonical analytics data is written to Doris.
LANGFUSE_INGESTION_MASKING_CALLBACK_URL=
LANGFUSE_INGESTION_MASKING_CALLBACK_TIMEOUT_MS=500
LANGFUSE_INGESTION_MASKING_CALLBACK_FAIL_CLOSED=false
LANGFUSE_INGESTION_MASKING_MAX_RETRIES=1
LANGFUSE_INGESTION_MASKING_PROPAGATED_HEADERS=

# Keep false by default. For a proven fresh deployment only, change to true,
# wait for Web readiness, then return to false before starting Worker.
LANGFUSE_ANALYTICS_ALLOW_FRESH_INITIALIZATION=false
LANGFUSE_ANALYTICS_WORKLOAD_EPOCH_HOST_PATH=./runtime-secrets/analytics-workload-epoch
LANGFUSE_WEB_RUNTIME_INSTANCE_ID=web-compose-1
LANGFUSE_WORKER_RUNTIME_INSTANCE_ID=worker-compose-1

# Doris 4.0.7 FE MySQL query endpoint. The URL must not contain credentials.
DORIS_QUERY_URL=mysql://doris-fe.internal.example:9030/langfuse
DORIS_WEB_QUERY_USER=
DORIS_WEB_QUERY_PASSWORD=
DORIS_WORKER_QUERY_USER=
DORIS_WORKER_QUERY_PASSWORD=
DORIS_QUERY_TLS_CA_HOST_PATH=./runtime-secrets/doris-query-ca.pem
DORIS_QUERY_MAX_CONNECTIONS=25
DORIS_QUERY_CONNECT_TIMEOUT_MS=10000
DORIS_QUERY_TIMEOUT_MS=30000

# One-shot migrator identity. It is never injected into Web or Worker.
DORIS_MIGRATION_URL=mysql://doris-fe.internal.example:9030/langfuse
DORIS_MIGRATION_USER=
DORIS_MIGRATION_PASSWORD=
DORIS_MIGRATION_TLS_CA_HOST_PATH=./runtime-secrets/doris-migration-ca.pem
DORIS_MIGRATION_CONNECT_TIMEOUT_MS=10000
DORIS_MIGRATION_QUERY_TIMEOUT_MS=120000

# Worker-only Stream Load identity and pinned redirect topology.
DORIS_STREAM_LOAD_FE_URL=https://doris-fe.internal.example:8030
DORIS_STREAM_LOAD_DATABASE=langfuse
DORIS_STREAM_LOAD_USER=
DORIS_STREAM_LOAD_PASSWORD=
DORIS_STREAM_LOAD_FE_IP_ALLOWLIST=
DORIS_STREAM_LOAD_BE_ALLOWLIST=https://doris-be-1.internal.example:8040
DORIS_STREAM_LOAD_BE_IP_ALLOWLIST=
DORIS_STREAM_LOAD_TLS_CA_HOST_PATH=./runtime-secrets/doris-stream-load-ca.pem
DORIS_STREAM_LOAD_REQUEST_TIMEOUT_MS=30000
DORIS_STREAM_LOAD_MAX_BODY_BYTES=104857600

# Object storage. Change external endpoints when users do not reach this host
# as localhost.
LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=http://localhost:9090
LANGFUSE_S3_BATCH_EXPORT_EXTERNAL_ENDPOINT=http://localhost:9090
LANGFUSE_S3_BATCH_EXPORT_ENABLED=true

# Optional. Leave retention unset until backup and restore have been proven.
LANGFUSE_DORIS_GLOBAL_RETENTION_DAYS=
LANGFUSE_DORIS_PARQUET_SCRATCH_HOST_PATH=./runtime-data/doris-parquet-scratch
LANGFUSE_DORIS_PARQUET_SCRATCH_MAX_BYTES=2147483648

# Optional deterministic first user/project. Prefer creating these in the UI.
LANGFUSE_INIT_ORG_ID=
LANGFUSE_INIT_ORG_NAME=
LANGFUSE_INIT_PROJECT_ID=
LANGFUSE_INIT_PROJECT_NAME=
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=

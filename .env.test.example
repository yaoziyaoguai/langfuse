# Test Environment Configuration
# Copy this file to .env.test for test database isolation
# Only overrides specific test variables - other values inherited from .env

# PostgreSQL - Test Database
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/langfuse_test"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/langfuse_test"

# ClickHouse - Use Default Database for now, nothing set

# Doris integration tests are opt-in and use the local 4.0.7 compose profile.
# DORIS_POC_ENABLED=1
# DORIS_POC_FE_HOST=127.0.0.1
# DORIS_POC_FE_MYSQL_PORT=9031
# DORIS_POC_DATABASE=langfuse_poc
# Optional real-Postgres control-state integration test; the database must have
# the full Prisma migration chain applied and should be isolated from production.
# DORIS_CONTROL_TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/langfuse_test"

# Redis - Test Database (database 1 for isolation)
REDIS_CONNECTION_STRING="redis://:myredissecret@127.0.0.1:6379/1"
